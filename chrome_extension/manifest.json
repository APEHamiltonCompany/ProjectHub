{
  "manifest_version": 3,
  "name": "Project Hub Tab Groups",
  "version": "2.0.0",
  "description": "Opens a Project Hub project's links as a Chrome tab group.",
  "permissions": ["tabs", "tabGroups", "scripting"],
  "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
